# Required for the contact form API (local dev + Vercel)
RESEND_API_KEY=re_your_key_here

# Resend sandbox (onboarding@resend.dev) can ONLY send to your Resend account email.
# Use that address here until you verify your own domain.
RESEND_TO=your-resend-account-email@example.com

# Optional — use after verifying a domain at https://resend.com/domains
# RESEND_FROM=Portfolio Contact <contact@yourdomain.com>
